"""FlySys variometer hardware schematic."""

import Capacitor
import ElectricPower
import Electrical
import RectangularBoardShape
import Resistor

from "parts/Bosch_Sensortec_BMI323/Bosch_Sensortec_BMI323.ato" import Bosch_Sensortec_BMI323_package
from "parts/Bosch_Sensortec_BMP581/Bosch_Sensortec_BMP581.ato" import Bosch_Sensortec_BMP581_package
from "parts/Bosch_Sensortec_BMP581/Bosch_Sensortec_BMP581.ato" import Bosch_Sensortec_BMP581_U6_package
from "parts/Alpha_Omega_AO3400A/Alpha_Omega_AO3400A.ato" import Alpha_Omega_AO3400A_Q1_package
from "parts/Alpha_Omega_AO3400A/Alpha_Omega_AO3400A.ato" import Alpha_Omega_AO3400A_Q2_package
from "parts/Alpha_Omega_AO3400A/Alpha_Omega_AO3400A.ato" import Alpha_Omega_AO3400A_Q3_package
from "parts/Alpha_Omega_AO3400A/Alpha_Omega_AO3400A.ato" import Alpha_Omega_AO3400A_Q5_package
from "parts/CK_KMR211NG_LFS/CK_KMR211NG_LFS.ato" import CK_KMR211NG_LFS_package
from "parts/CK_KMR211NG_LFS/CK_KMR211NG_LFS.ato" import CK_KMR211NG_LFS_SW2_package
from "parts/CK_KMR211NG_LFS/CK_KMR211NG_LFS.ato" import CK_KMR211NG_LFS_SW3_package
from "parts/Diodes_Inc_1N4148W/Diodes_Inc_1N4148W.ato" import Diodes_Inc_1N4148W_D2_package
from "parts/Diodes_Inc_1N4148W/Diodes_Inc_1N4148W.ato" import Diodes_Inc_1N4148W_D3_package
from "parts/Diodes_Inc_1N4148W/Diodes_Inc_1N4148W.ato" import Diodes_Inc_1N4148W_D4_package
from "parts/Diodes_Inc_DMP3098L/DMP3098L.ato" import Diodes_Inc_DMP3098L_Q4_package
from "parts/Espressif_Systems_ESP32_S3_WROOM_1U_N8/Espressif_Systems_ESP32_S3_WROOM_1U_N8.ato" import Espressif_Systems_ESP32_S3_WROOM_1U_N8_package
from "parts/GCT_USB4105_GF_A/GCT_USB4105_GF_A.ato" import GCT_USB4105_GF_A_package
from "parts/JST_S2B_PH_SM4_TB/JST_S2B_PH_SM4_TB.ato" import JST_S2B_PH_SM4_TB_package
from "parts/Lite_On_LTST_C190GKT/Lite_On_LTST_C190GKT.ato" import Lite_On_LTST_C190GKT_package
from "parts/Lite_On_LTST_C190TBKT/Lite_On_LTST_C190TBKT.ato" import Lite_On_LTST_C190TBKT_package
from "parts/Same_Sky_CSS_J4D20_SMT_TR/Same_Sky_CSS_J4D20_SMT_TR.ato" import Same_Sky_CSS_J4D20_SMT_TR_package
from "parts/STMicroelectronics_USBLC6_2SC6/STMicroelectronics_USBLC6_2SC6.ato" import STMicroelectronics_USBLC6_2SC6Y_package
from "parts/Texas_Instruments_BQ24075RGTR/Texas_Instruments_BQ24075RGTR.ato" import Texas_Instruments_BQ24075RGTR_package
from "parts/Texas_Instruments_TLV75533PDBVR/Texas_Instruments_TLV75533PDBVR.ato" import Texas_Instruments_TLV75533PDBVR_package


module FlySysVario:
    board = new RectangularBoardShape
    board.x = 90mm
    board.y = 45mm
    board.corner_radius = 0mm

    gnd = new Electrical
    usb_vbus = new ElectricPower
    sys = new ElectricPower
    v3v3 = new ElectricPower
    bat_raw = new ElectricPower
    bat = new ElectricPower

    gnd.override_net_name = "GND"
    usb_vbus.hv.override_net_name = "USB_VBUS"
    sys.hv.override_net_name = "SYS"
    v3v3.hv.override_net_name = "+3V3"
    bat_raw.hv.override_net_name = "BAT_RAW"
    bat.hv.override_net_name = "BAT"

    usb_vbus.lv ~ gnd
    sys.lv ~ gnd
    v3v3.lv ~ gnd
    bat_raw.lv ~ gnd
    bat.lv ~ gnd

    assert usb_vbus.voltage within 4.75V to 5.25V
    assert sys.voltage within 3.0V to 5.5V
    assert v3v3.voltage within 3.3V +/- 5%
    assert bat_raw.voltage within 3.0V to 4.2V
    assert bat.voltage within 3.0V to 4.2V

    usb = new GCT_USB4105_GF_A_package
    usb_esd = new STMicroelectronics_USBLC6_2SC6Y_package
    charger = new Texas_Instruments_BQ24075RGTR_package
    ldo_3v3 = new Texas_Instruments_TLV75533PDBVR_package
    battery = new JST_S2B_PH_SM4_TB_package
    mcu = new Espressif_Systems_ESP32_S3_WROOM_1U_N8_package
    pressure_1 = new Bosch_Sensortec_BMP581_package
    pressure_2 = new Bosch_Sensortec_BMP581_U6_package
    imu = new Bosch_Sensortec_BMI323_package
    buzzer = new Same_Sky_CSS_J4D20_SMT_TR_package
    q_buzzer = new Alpha_Omega_AO3400A_Q1_package
    q_ble_led = new Alpha_Omega_AO3400A_Q2_package
    q_sysoff = new Alpha_Omega_AO3400A_Q3_package
    q_bat_switch = new Diodes_Inc_DMP3098L_Q4_package
    q_bat_gate = new Alpha_Omega_AO3400A_Q5_package
    d_pwr_btn_sense = new Diodes_Inc_1N4148W_D2_package
    d_bat_gate_button = new Diodes_Inc_1N4148W_D3_package
    d_sysoff_button = new Diodes_Inc_1N4148W_D4_package
    user_button = new CK_KMR211NG_LFS_package
    boot_button = new CK_KMR211NG_LFS_SW2_package
    reset_button = new CK_KMR211NG_LFS_SW3_package
    power_led = new Lite_On_LTST_C190GKT_package
    ble_led = new Lite_On_LTST_C190TBKT_package

    usb_dp_conn = new Electrical
    usb_dm_conn = new Electrical
    usb_dp_mcu = new Electrical
    usb_dm_mcu = new Electrical
    i2c_scl = new Electrical
    i2c_sda = new Electrical
    bmp581_1_int = new Electrical
    bmp581_2_int = new Electrical
    en = new Electrical
    boot_user_btn_n = new Electrical
    pwr_sw_n = new Electrical
    pwr_btn_n = new Electrical
    chg_sysoff = new Electrical
    pwr_hold = new Electrical
    pwr_hold_gate = new Electrical
    bat_switch_gate = new Electrical
    bat_sense = new Electrical
    usb_vbus_sense = new Electrical
    buzzer_gate = new Electrical
    ble_led_gate = new Electrical

    usb_dp_conn.override_net_name = "USB_DP_CONN"
    usb_dm_conn.override_net_name = "USB_DM_CONN"
    usb_dp_mcu.override_net_name = "USB_OTG_DP"
    usb_dm_mcu.override_net_name = "USB_OTG_DM"
    i2c_scl.override_net_name = "I2C_SCL"
    i2c_sda.override_net_name = "I2C_SDA"
    bmp581_1_int.override_net_name = "BMP581_1_INT"
    bmp581_2_int.override_net_name = "BMP581_2_INT"
    en.override_net_name = "EN"
    boot_user_btn_n.override_net_name = "BOOT_USER_BTN_N"
    pwr_sw_n.override_net_name = "PWR_SW_N"
    pwr_btn_n.override_net_name = "PWR_BTN_N"
    chg_sysoff.override_net_name = "CHG_SYSOFF"
    pwr_hold.override_net_name = "PWR_HOLD"
    pwr_hold_gate.override_net_name = "PWR_HOLD_GATE"
    bat_switch_gate.override_net_name = "BAT_SWITCH_GATE"
    bat_sense.override_net_name = "BAT_SENSE"
    usb_vbus_sense.override_net_name = "USB_VBUS_SENSE"
    buzzer_gate.override_net_name = "BUZZER_GATE"
    ble_led_gate.override_net_name = "BLE_LED_GATE"

    # USB-C receptacle, ESD protection, and USB2 routing.
    usb.VBUS ~ usb_vbus.hv
    usb.GND ~ gnd
    usb.EH ~ gnd
    usb.CC1 ~> r_cc1 ~> gnd
    usb.CC2 ~> r_cc2 ~> gnd
    r_cc1 = new Resistor
    r_cc2 = new Resistor
    r_cc1.resistance = 5.1kohm +/- 1%
    r_cc2.resistance = 5.1kohm +/- 1%
    r_cc1.package = "0603"
    r_cc2.package = "0603"

    usb.DP1 ~ usb_dp_conn
    usb.DP2 ~ usb_dp_conn
    usb.DN1 ~ usb_dm_conn
    usb.DN2 ~ usb_dm_conn
    usb_esd.IO1_A ~ usb_dp_conn
    usb_esd.IO1_B ~ usb_dp_mcu
    usb_esd.IO2_A ~ usb_dm_conn
    usb_esd.IO2_B ~ usb_dm_mcu
    usb_esd.VBUS ~ usb_vbus.hv
    usb_esd.GND ~ gnd

    mcu.IO20 ~ usb_dp_mcu
    mcu.IO19 ~ usb_dm_mcu

    # Charger and power-path management.
    charger.IN ~ usb_vbus.hv
    charger.OUT ~ sys.hv
    charger.BAT ~ bat.hv
    charger.VSS ~ gnd
    charger.EP ~ gnd
    charger.nCE ~ gnd
    charger.EN1 ~ gnd
    charger.EN2 ~ sys.hv
    charger.SYSOFF ~ chg_sysoff
    chg_sysoff ~> r_sysoff_pullup ~> bat.hv
    chg_sysoff ~ q_sysoff.DRAIN
    q_sysoff.SOURCE ~ gnd
    mcu.IO10 ~> r_pwr_hold_gate ~> pwr_hold_gate
    pwr_hold_gate ~ q_sysoff.GATE
    pwr_hold_gate ~> r_pwr_hold_gate_pu ~> v3v3.hv
    pwr_hold_gate ~> r_pwr_hold_gate_pd ~> gnd
    q_bat_switch.SOURCE ~ bat_raw.hv
    q_bat_switch.DRAIN ~ bat.hv
    q_bat_switch.GATE ~ bat_switch_gate
    bat_switch_gate ~> r_bat_switch_gate_pu ~> bat_raw.hv
    bat_switch_gate ~ q_bat_gate.DRAIN
    q_bat_gate.SOURCE ~ gnd
    q_bat_gate.GATE ~ pwr_hold_gate
    d_pwr_btn_sense.A ~ pwr_btn_n
    d_pwr_btn_sense.K ~ pwr_sw_n
    d_bat_gate_button.A ~ bat_switch_gate
    d_bat_gate_button.K ~ pwr_sw_n
    d_sysoff_button.A ~ chg_sysoff
    d_sysoff_button.K ~ pwr_sw_n
    charger.TS ~> r_chg_ts ~> gnd
    charger.ISET ~> r_chg_iset ~> gnd
    charger.ILIM ~> r_chg_ilim ~> gnd
    charger.TMR ~> r_chg_tmr ~> gnd
    charger.nCHG ~> r_chg_pullup ~> v3v3.hv
    charger.nPGOOD ~> r_pgood_pullup ~> v3v3.hv
    charger.nCHG ~ mcu.IO37
    charger.nPGOOD ~ mcu.IO38

    r_chg_ts = new Resistor
    r_chg_iset = new Resistor
    r_chg_ilim = new Resistor
    r_chg_tmr = new Resistor
    r_chg_pullup = new Resistor
    r_pgood_pullup = new Resistor
    r_sysoff_pullup = new Resistor
    r_pwr_hold_gate = new Resistor
    r_pwr_hold_gate_pu = new Resistor
    r_pwr_hold_gate_pd = new Resistor
    r_bat_switch_gate_pu = new Resistor
    r_chg_ts.resistance = 10kohm +/- 1%
    r_chg_iset.resistance = 2kohm +/- 1%
    r_chg_ilim.resistance = 1.1kohm +/- 1%
    r_chg_tmr.resistance = 47kohm +/- 1%
    r_chg_pullup.resistance = 10kohm +/- 1%
    r_pgood_pullup.resistance = 10kohm +/- 1%
    r_sysoff_pullup.resistance = 1Mohm +/- 1%
    r_pwr_hold_gate.resistance = 100ohm +/- 5%
    r_pwr_hold_gate_pu.resistance = 100kohm +/- 5%
    r_pwr_hold_gate_pd.resistance = 1Mohm +/- 1%
    r_bat_switch_gate_pu.resistance = 1Mohm +/- 1%
    r_chg_ts.package = "0603"
    r_chg_iset.package = "0603"
    r_chg_ilim.package = "0603"
    r_chg_tmr.package = "0603"
    r_chg_pullup.package = "0603"
    r_pgood_pullup.package = "0603"
    r_sysoff_pullup.package = "0603"
    r_pwr_hold_gate.package = "0603"
    r_pwr_hold_gate_pu.package = "0603"
    r_pwr_hold_gate_pd.package = "0603"
    r_bat_switch_gate_pu.package = "0603"

    battery.BAT_POS ~ bat_raw.hv
    battery.BAT_NEG ~ gnd

    ldo_3v3.IN ~ sys.hv
    ldo_3v3.OUT ~ v3v3.hv
    ldo_3v3.EN ~ sys.hv
    ldo_3v3.GND ~ gnd

    usb_vbus.hv ~> c_vbus_in ~> gnd
    sys.hv ~> c_sys_bulk ~> gnd
    bat.hv ~> c_bat_bulk ~> gnd
    sys.hv ~> c_ldo_in ~> gnd
    v3v3.hv ~> c_ldo_out ~> gnd
    v3v3.hv ~> c_mcu_bulk ~> gnd
    v3v3.hv ~> c_mcu_decoup ~> gnd

    c_vbus_in = new Capacitor
    c_sys_bulk = new Capacitor
    c_bat_bulk = new Capacitor
    c_ldo_in = new Capacitor
    c_ldo_out = new Capacitor
    c_mcu_bulk = new Capacitor
    c_mcu_decoup = new Capacitor
    c_vbus_in.capacitance = 1uF +/- 20%
    c_sys_bulk.capacitance = 10uF +/- 20%
    c_bat_bulk.capacitance = 10uF +/- 20%
    c_ldo_in.capacitance = 1uF +/- 20%
    c_ldo_out.capacitance = 1uF +/- 20%
    c_mcu_bulk.capacitance = 10uF +/- 20%
    c_mcu_decoup.capacitance = 100nF +/- 10%
    c_vbus_in.package = "0603"
    c_sys_bulk.package = "0603"
    c_bat_bulk.package = "0603"
    c_ldo_in.package = "0603"
    c_ldo_out.package = "0603"
    c_mcu_bulk.package = "0603"
    c_mcu_decoup.package = "0603"

    # ESP32-S3 bring-up, USB VBUS sense, battery sense, and button access.
    # BOOT and RESET are hidden recovery controls; normal firmware update is
    # handled by application firmware over USB/BLE/OTA.
    mcu.P3V3 ~ v3v3.hv
    mcu.SIG_GND ~ gnd
    mcu.EN ~ en
    en ~> r_en_pullup ~> v3v3.hv
    en ~> c_en ~> gnd
    reset_button.A ~ en
    reset_button.B ~ gnd
    mcu.IO0 ~ boot_user_btn_n
    boot_user_btn_n ~> r_boot_pullup ~> v3v3.hv
    boot_button.A ~ boot_user_btn_n
    boot_button.B ~ gnd
    mcu.IO7 ~ pwr_btn_n
    pwr_btn_n ~> r_pwr_btn_pullup ~> v3v3.hv
    user_button.A ~ pwr_sw_n
    user_button.B ~ gnd

    r_en_pullup = new Resistor
    r_boot_pullup = new Resistor
    r_pwr_btn_pullup = new Resistor
    c_en = new Capacitor
    r_en_pullup.resistance = 10kohm +/- 1%
    r_boot_pullup.resistance = 10kohm +/- 1%
    r_pwr_btn_pullup.resistance = 4.7kohm +/- 1%
    c_en.capacitance = 100nF +/- 10%
    r_en_pullup.package = "0603"
    r_boot_pullup.package = "0603"
    r_pwr_btn_pullup.package = "0603"
    c_en.package = "0603"

    bat.hv ~> r_bat_sense_top ~> bat_sense ~> r_bat_sense_bottom ~> gnd
    bat_sense ~> c_bat_sense ~> gnd
    mcu.IO1 ~ bat_sense
    usb_vbus.hv ~> r_vbus_sense_top ~> usb_vbus_sense ~> r_vbus_sense_bottom ~> gnd
    mcu.IO2 ~ usb_vbus_sense

    r_bat_sense_top = new Resistor
    r_bat_sense_bottom = new Resistor
    r_vbus_sense_top = new Resistor
    r_vbus_sense_bottom = new Resistor
    c_bat_sense = new Capacitor
    r_bat_sense_top.resistance = 1Mohm +/- 1%
    r_bat_sense_bottom.resistance = 1Mohm +/- 1%
    r_vbus_sense_top.resistance = 1Mohm +/- 1%
    r_vbus_sense_bottom.resistance = 330kohm +/- 1%
    c_bat_sense.capacitance = 100nF +/- 10%
    r_bat_sense_top.package = "0603"
    r_bat_sense_bottom.package = "0603"
    r_vbus_sense_top.package = "0603"
    r_vbus_sense_bottom.package = "0603"
    c_bat_sense.package = "0603"

    # Shared I2C sensor bus.
    mcu.IO8 ~ i2c_scl
    mcu.IO9 ~ i2c_sda
    i2c_scl ~> r_i2c_scl_pullup ~> v3v3.hv
    i2c_sda ~> r_i2c_sda_pullup ~> v3v3.hv
    r_i2c_scl_pullup = new Resistor
    r_i2c_sda_pullup = new Resistor
    r_i2c_scl_pullup.resistance = 4.7kohm +/- 1%
    r_i2c_sda_pullup.resistance = 4.7kohm +/- 1%
    r_i2c_scl_pullup.package = "0603"
    r_i2c_sda_pullup.package = "0603"

    pressure_1.VDD ~ v3v3.hv
    pressure_1.VDDIO ~ v3v3.hv
    pressure_1.VSS ~ gnd
    pressure_1.SCK ~ i2c_scl
    pressure_1.SDI ~ i2c_sda
    pressure_1.SDO ~ gnd
    pressure_1.CSB ~ v3v3.hv
    pressure_1.INT ~ bmp581_1_int
    mcu.IO4 ~ bmp581_1_int
    v3v3.hv ~> c_pressure1_vdd ~> gnd
    v3v3.hv ~> c_pressure1_vddio ~> gnd
    c_pressure1_vdd = new Capacitor
    c_pressure1_vddio = new Capacitor
    c_pressure1_vdd.capacitance = 100nF +/- 10%
    c_pressure1_vddio.capacitance = 100nF +/- 10%
    c_pressure1_vdd.package = "0603"
    c_pressure1_vddio.package = "0603"

    pressure_2.VDD ~ v3v3.hv
    pressure_2.VDDIO ~ v3v3.hv
    pressure_2.VSS ~ gnd
    pressure_2.SCK ~ i2c_scl
    pressure_2.SDI ~ i2c_sda
    pressure_2.SDO ~ v3v3.hv
    pressure_2.CSB ~ v3v3.hv
    pressure_2.INT ~ bmp581_2_int
    mcu.IO16 ~ bmp581_2_int
    v3v3.hv ~> c_pressure2_vdd ~> gnd
    v3v3.hv ~> c_pressure2_vddio ~> gnd
    c_pressure2_vdd = new Capacitor
    c_pressure2_vddio = new Capacitor
    c_pressure2_vdd.capacitance = 100nF +/- 10%
    c_pressure2_vddio.capacitance = 100nF +/- 10%
    c_pressure2_vdd.package = "0603"
    c_pressure2_vddio.package = "0603"

    imu.VDD ~ v3v3.hv
    imu.VDDIO ~ v3v3.hv
    imu.GND ~ gnd
    imu.GNDIO ~ gnd
    imu.SCX ~ i2c_scl
    imu.SDX ~ i2c_sda
    imu.SDO ~ gnd
    imu.CSB ~ v3v3.hv
    imu.INT1 ~ mcu.IO5
    imu.INT2 ~ mcu.IO6
    v3v3.hv ~> c_imu_vdd ~> gnd
    v3v3.hv ~> c_imu_vddio ~> gnd
    c_imu_vdd = new Capacitor
    c_imu_vddio = new Capacitor
    c_imu_vdd.capacitance = 100nF +/- 10%
    c_imu_vddio.capacitance = 100nF +/- 10%
    c_imu_vdd.package = "0603"
    c_imu_vddio.package = "0603"

    # Loud passive buzzer driven from SYS with a PWM low-side switch.
    buzzer.POS ~ sys.hv
    buzzer.NEG ~ q_buzzer.DRAIN
    q_buzzer.SOURCE ~ gnd
    mcu.IO17 ~> r_buzzer_gate ~> buzzer_gate
    buzzer_gate ~ q_buzzer.GATE
    buzzer_gate ~> r_buzzer_gate_pd ~> gnd
    sys.hv ~> c_buzzer_bulk ~> gnd

    r_buzzer_gate = new Resistor
    r_buzzer_gate_pd = new Resistor
    c_buzzer_bulk = new Capacitor
    r_buzzer_gate.resistance = 100ohm +/- 5%
    r_buzzer_gate_pd.resistance = 100kohm +/- 5%
    c_buzzer_bulk.capacitance = 10uF +/- 20%
    r_buzzer_gate.package = "0603"
    r_buzzer_gate_pd.package = "0603"
    c_buzzer_bulk.package = "0603"

    # Green power-present LED from +3V3 and blue BLE pairing LED from SYS.
    v3v3.hv ~> r_power_led ~> power_led.pos
    power_led.neg ~ gnd
    sys.hv ~> r_ble_led ~> ble_led.A
    ble_led.K ~ q_ble_led.DRAIN
    q_ble_led.SOURCE ~ gnd
    mcu.IO18 ~> r_ble_gate ~> ble_led_gate
    ble_led_gate ~ q_ble_led.GATE
    ble_led_gate ~> r_ble_gate_pd ~> gnd

    r_power_led = new Resistor
    r_ble_led = new Resistor
    r_ble_gate = new Resistor
    r_ble_gate_pd = new Resistor
    r_power_led.resistance = 1kohm +/- 5%
    r_ble_led.resistance = 1kohm +/- 5%
    r_ble_gate.resistance = 100ohm +/- 5%
    r_ble_gate_pd.resistance = 100kohm +/- 5%
    r_power_led.package = "0603"
    r_ble_led.package = "0603"
    r_ble_gate.package = "0603"
    r_ble_gate_pd.package = "0603"
