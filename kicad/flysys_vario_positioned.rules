
(rules PCB flysys_vario_positioned.dsn
  (snap_angle 
    fortyfive_degree
  )
  (rule
    (width 150.0)
    (clearance 250.0)
    (clearance 250.0 (type smd_to_turn_gap))
    (clearance 62.6 (type smd))
    (clearance 250.0 (type "kicad_default"))
  )
  (padstack "Via[0-1]_1600:600_um"
    (shape
      (circle F.Cu 1600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 1600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_1600:600_um" "Via[0-1]_1600:600_um" default
  )
  (via 
    "Via[0-1]_1600:600_um-kicad_default" "Via[0-1]_1600:600_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_1600:600_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_1600:600_um-kicad_default"
  )
  (class default
    (clearance_class default)
    (via_rule default)
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    "/BUZZER_NEG" /SYS /GND /BAT "/BAT_SENSE" /EN /+3V3 "/USB_VBUS"
    "/USB_DP_CONN" "/USB_DM_CONN" "/USB_OTG_DP" "/USB_OTG_DM" /RXD0 "/BOOT_USER_BTN_N" /TXD0 "/BLE_LED_K"
    "/BLE_LED_A" "/POWER_LED_A" "/BUZZER_GATE" "/BLE_LED_GATE" "/BLE_LED_PWM" "/BUZZER_PWM" /CC1 /CC2
    "/CHG_ILIM" "/CHG_ISET" /nCHG "/CHG_TMR" "/CHG_TS" "/I2C_SCL" "/I2C_SDA" /nPGOOD
    "/USB_VBUS_SENSE" "/BMI323_INT2" "/BMI323_INT1" "/BMP581_INT"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 150.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class signal
    "unconnected-(U2-NC-Pad10)" "unconnected-(U2-NC-Pad3)" "unconnected-(U2-NC-Pad2)" "unconnected-(U2-NC-Pad11)" "unconnected-(U3-NC-Pad4)" "unconnected-(U4-IO39-Pad35)" "unconnected-(U4-IO40-Pad36)" "unconnected-(U4-IO21-Pad25)"
    "unconnected-(U4-IO10-Pad14)" "unconnected-(U4-IO42-Pad38)" "unconnected-(U4-IO26-Pad26)" "unconnected-(U4-IO48-Pad30)" "unconnected-(U4-IO14-Pad18)" "unconnected-(U4-IO33-Pad28)" "unconnected-(U4-IO41-Pad37)" "unconnected-(U4-IO36-Pad32)"
    "unconnected-(U4-IO45-Pad41)" "unconnected-(U4-IO34-Pad29)" "unconnected-(U4-IO7-Pad11)" "unconnected-(U4-IO15-Pad19)" "unconnected-(U4-IO3-Pad7)" "unconnected-(U4-IO16-Pad20)" "unconnected-(U4-IO11-Pad15)" "unconnected-(U4-IO12-Pad16)"
    "unconnected-(U4-IO46-Pad44)" "unconnected-(U4-IO13-Pad17)" "unconnected-(U4-IO35-Pad31)" "unconnected-(U4-IO47-Pad27)" "unconnected-(USB1-SBU1-PadA8)" "unconnected-(USB1-SBU2-PadB8)"
    (clearance_class smd)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)