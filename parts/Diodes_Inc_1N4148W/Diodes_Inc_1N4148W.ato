import has_designator
import has_designator_prefix
import is_atomic_part

component Diodes_Inc_1N4148W_D2_package:
    """1N4148W small-signal diode in SOD-123."""

    trait is_atomic_part<manufacturer="Diodes Incorporated", partnumber="1N4148W-7-F", footprint="1N4148W.kicad_mod", symbol="1N4148W.kicad_sym">
    trait has_designator<designator="D2">
    trait has_designator_prefix<prefix="D">

    signal K ~ pin 1
    signal A ~ pin 2


