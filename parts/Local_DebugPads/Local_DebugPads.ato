import has_designator
import has_designator_prefix
import is_atomic_part

component DebugPads_package:
    """Bring-up/debug pad row for power, EN/BOOT, and UART0."""

    trait is_atomic_part<manufacturer="Local", partnumber="DebugPads_1x06_1.27mm", footprint="DebugPads_1x06_1.27mm.kicad_mod", symbol="DebugPads_1x06_1.27mm.kicad_sym">
    trait has_designator<designator="J2">
    trait has_designator_prefix<prefix="J">

    signal GND ~ pin 1
    signal P3V3 ~ pin 2
    signal EN ~ pin 3
    signal BOOT ~ pin 4
    signal TXD0 ~ pin 5
    signal RXD0 ~ pin 6
